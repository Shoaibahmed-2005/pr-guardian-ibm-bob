{
  "mcpServers": {
    "pr-guardian": {
      "command": "python",
      "args": ["-m", "mcp_server.server"],
      "env": {
        "GITHUB_TOKEN": "your_github_token_here",
        "WATSONX_API_KEY": "your_watsonx_api_key_here",
        "WATSONX_PROJECT_ID": "your_project_id_here",
        "AI_PROVIDER": "watsonx"
      },
      "description": "PR Guardian - Automated PR review with security analysis, bug detection, and test suggestions"
    }
  }
}